# ==============================================================================
# Robot Identification Settings
# ==============================================================================
# Client id needed for communicating with destiny repository (Required)
ROBOT_ID=123e4567-e89b-12d3-a456-426614174000

# Semantic version of the robot (Must match pattern: [0-9]+.[0-9]+.[0-9]+)
# Defaults to version in pyproject.toml
#ROBOT_VERSION=0.1.0

# Name of the robot (Must match pattern: ([a-z]+-)+)
# Defaults to project name in pyproject.toml
#ROBOT_NAME=ic1-robot

# Secret needed for communicating with destiny repo (Required)
ROBOT_SECRET=your-robot-secret-here

# ==============================================================================
# Repository Settings
# ==============================================================================
# DESTinY repository API endpoint
BASE_URL=https://api.staging.evidence-repository.org

# The environment this robot is deployed in
# Allowed values: local, development, staging, production, test
ENV=staging

# ==============================================================================
# Robot Looping Settings
# ==============================================================================
# How long to sleep between each loop (in seconds)
INTERVAL_SECONDS=30

# The number of references to include per batch
BATCH_SIZE=10

# How long the repository leases a polled batch for. Must outlast the time it takes to
# annotate a batch, or the repository redelivers it. Unset uses the repository's default.
#BATCH_LEASE_SECONDS=3600

# ==============================================================================
# LLM Rate Limiting & Retries
# ==============================================================================
# Per container: the 10M TPM / 10k RPM deployment quota split across replicas
LLM_REQUESTS_PER_MINUTE=3000
LLM_TOKENS_PER_MINUTE=3000000

# Completion tokens reserved per prompt. Raise if the litellm spans show larger completions
LLM_EXPECTED_OUTPUT_TOKENS=1500

# Retries inside the OpenAI client (429/5xx, honours Retry-After) - read by litellm at import
DEFAULT_MAX_RETRIES=3

# Without this litellm drops its per-call span when our batch span is the parent, and writes
# gen_ai.* onto the batch span instead
USE_OTEL_LITELLM_REQUEST_SPAN=true

# Retries per document on transient errors before it's recorded as a failure
LLM_NUM_RETRIES=3

# References extracted at once; sizes the extractor's own thread pool (not asyncio's default executor)
LLM_MAX_CONCURRENT_EXTRACTIONS=50

# Shut down (leaving the batch for redelivery) if more than this fraction fail after retries
ABANDON_THRESHOLD=0.1

# ==============================================================================
# Document size settings
# ==============================================================================
# Documents outside of these bounds are not processed and marked as failed
MIN_DOCUMENT_TOKENS=50
MAX_DOCUMENT_TOKENS=1500

# ==============================================================================
# Extraction Bundle
# ==============================================================================
# Path to the frozen deet extraction config (TTL and mapping sit alongside it)
EXTRACTION_CONFIG=.configs/taxonomy/extraction_config.yaml

# ==============================================================================
# Upstream Trigger
# ==============================================================================
# Inclusion annotation that marks a reference ready for taxonomy annotation
UPSTREAM_SCHEME=domain-inclusion
UPSTREAM_LABEL=destiny-high-precision

# ==============================================================================
# Vocabulary
# ==============================================================================
# UID and version of the published vocabulary in the evidence-repository Builder
VOCABULARY_UID=019db9f2-6c04-7795-a242-3ab8e8e2120a
VOCABULARY_VERSION=1.6

# ==============================================================================
# LLM Provider (Azure) — credentials passed through to deet/litellm
# ==============================================================================
AZURE_API_KEY=your-azure-api-key-here
AZURE_API_BASE=https://your-endpoint.services.ai.azure.com/models

# ==============================================================================
# Observability (OpenTelemetry -> Honeycomb)
# ==============================================================================
# Export traces to Honeycomb over OTLP/HTTP. Everything below is ignored unless true.
OTEL_ENABLED=false

# Honeycomb export config as JSON — only api_key is normally needed.
#OTEL_CONFIG='{"api_key": "your-honeycomb-key"}'

# Attach prompt/abstract text to LLM spans — off by default.
OTEL_CAPTURE_LLM_CONTENT=false

# ==============================================================================
# Enhancement Settings
# ==============================================================================
ENHANCEMENT_VISIBILITY=public
